{
  "name": "@ora-space/codeagent",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --watch --no-prompt --allow-run --allow-read --allow-env --allow-net src/main.ts",
    "build": "deno run -A scripts/build.ts",
    "pack": "deno task build && orax pack",
    "check": "deno check src/main.ts tests/main_test.ts tests/host-simulator.ts",
    "test": "deno test --allow-read --allow-env tests/main_test.ts",
    "simulate": "deno run --allow-run --allow-read --allow-env --allow-net tests/host-simulator.ts",
    "format": "deno fmt"
  },
  "imports": {
    "@ora-space/plugin-sdk": "jsr:@ora-space/plugin-sdk@^0.1.3",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom"]
  },
  "fmt": {
    "exclude": ["dist/", "logo.svg"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2
  },
  "lint": {
    "exclude": ["dist/"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
